{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "package.json"
  },
  "mutate": [
    "App.{js,jsx,ts,tsx}",
    "{app,components,screens,hooks,services,utils}/**/*.{js,jsx,ts,tsx}",
    "!**/*.{test,spec}.{js,jsx,ts,tsx}",
    "!**/__tests__/**"
  ],
  "concurrency": 2
}